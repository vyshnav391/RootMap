from fastapi import FastAPI
from contextlib import asynccontextmanager
from router import router
from graph_client import close_driver


@asynccontextmanager
async def lifespan(app: FastAPI):
    yield
    await close_driver()


app = FastAPI(title="RootMap Selector Service", version="1.0.0", lifespan=lifespan)
app.include_router(router)


@app.get("/health")
async def health():
    return {"status": "ok", "service": "selector"}

from neo4j import AsyncGraphDatabase
from config import settings
import logging

logger = logging.getLogger(__name__)

_driver = None


async def get_driver():
    global _driver
    if _driver is None:
        _driver = AsyncGraphDatabase.driver(
            settings.neo4j_uri,
            auth=(settings.neo4j_user, settings.neo4j_password),
        )
    return _driver


async def close_driver():
    global _driver
    if _driver:
        await _driver.close()
        _driver = None


class GraphClient:
    def __init__(self, driver):
        self.driver = driver

    async def get_topic(self, topic_id: str) -> dict | None:
        async with self.driver.session() as session:
            result = await session.run(
                "MATCH (t:Topic {id: $id}) RETURN t",
                id=topic_id,
            )
            record = await result.single()
            return dict(record["t"]) if record else None

    async def get_all_topics(self, subject: str | None = None) -> list[dict]:
        async with self.driver.session() as session:
            if subject:
                result = await session.run(
                    "MATCH (t:Topic {subject: $subject}) RETURN t ORDER BY t.order",
                    subject=subject,
                )
            else:
                result = await session.run(
                    "MATCH (t:Topic) RETURN t ORDER BY t.subject, t.order"
                )
            return [dict(r["t"]) async for r in result]

    async def get_prerequisites(self, topic_id: str) -> list[dict]:
        async with self.driver.session() as session:
            result = await session.run(
                """
                MATCH (pre:Topic)-[:PREREQUISITE_OF]->(t:Topic {id: $id})
                RETURN pre
                """,
                id=topic_id,
            )
            return [dict(r["pre"]) async for r in result]

    async def get_questions_for_topic(
        self, topic_id: str, min_diff: float = 0.0, max_diff: float = 1.0, limit: int = 10
    ) -> list[dict]:
        async with self.driver.session() as session:
            result = await session.run(
                """
                MATCH (q:Question)-[:TESTS]->(t:Topic {id: $topic_id})
                WHERE q.difficulty >= $min_diff AND q.difficulty <= $max_diff
                RETURN q
                ORDER BY q.difficulty
                LIMIT $limit
                """,
                topic_id=topic_id,
                min_diff=min_diff,
                max_diff=max_diff,
                limit=limit,
            )
            return [dict(r["q"]) async for r in result]

    async def get_weakest_prerequisite(
        self, topic_id: str, mastery_map: dict[str, float]
    ) -> dict | None:
        """Find the prerequisite with lowest mastery that needs attention."""
        prerequisites = await self.get_prerequisites(topic_id)
        if not prerequisites:
            return None
        weakest = min(prerequisites, key=lambda p: mastery_map.get(p["id"], 0.0))
        if mastery_map.get(weakest["id"], 0.0) < 0.7:
            return weakest
        return None

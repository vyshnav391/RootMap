version: "3.9"

services:
  # ─── Infrastructure ──────────────────────────────────────────
  postgres:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_USER: rootmap
      POSTGRES_PASSWORD: rootmap
      POSTGRES_DB: rootmap
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U rootmap"]
      interval: 5s
      timeout: 5s
      retries: 5

  neo4j:
    image: neo4j:5.18-community
    environment:
      NEO4J_AUTH: neo4j/rootmap_neo4j
      NEO4J_PLUGINS: '["apoc"]'
      NEO4J_dbms_security_procedures_unrestricted: apoc.*
    ports:
      - "7474:7474"
      - "7687:7687"
    volumes:
      - neo4j_data:/data
    healthcheck:
      test: ["CMD", "cypher-shell", "-u", "neo4j", "-p", "rootmap_neo4j", "RETURN 1"]
      interval: 10s
      timeout: 10s
      retries: 10

  # ─── Services ────────────────────────────────────────────────
  api:
    build: ./services/api
    ports:
      - "8000:8000"
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://rootmap:rootmap@postgres:5432/rootmap
      DATABASE_URL_SYNC: postgresql://rootmap:rootmap@postgres:5432/rootmap
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./services/api:/app
    command: uvicorn main:app --host 0.0.0.0 --port 8000 --reload

  bkt:
    build: ./services/bkt
    ports:
      - "8001:8001"
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://rootmap:rootmap@postgres:5432/rootmap
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./services/bkt:/app
    command: uvicorn main:app --host 0.0.0.0 --port 8001 --reload

  selector:
    build: ./services/selector
    ports:
      - "8002:8002"
    env_file: .env
    environment:
      NEO4J_URI: bolt://neo4j:7687
      NEO4J_USER: neo4j
      NEO4J_PASSWORD: rootmap_neo4j
    depends_on:
      neo4j:
        condition: service_healthy
    volumes:
      - ./services/selector:/app
    command: uvicorn main:app --host 0.0.0.0 --port 8002 --reload

  planner:
    build: ./services/planner
    ports:
      - "8003:8003"
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://rootmap:rootmap@postgres:5432/rootmap
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./services/planner:/app
      - ./data:/data
    command: uvicorn main:app --host 0.0.0.0 --port 8003 --reload

  frontend:
    build: ./frontend
    ports:
      - "5173:5173"
    volumes:
      - ./frontend/src:/app/src
    environment:
      VITE_API_URL: http://localhost:8000
    depends_on:
      - api

volumes:
  postgres_data:
  neo4j_data:

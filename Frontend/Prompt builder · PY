from typing import List


def build_system_prompt() -> str:
    return """You are RootMap's expert study planner. You create personalized, structured weekly study plans.

Your plans are:
- Realistic and time-aware (respecting the student's available hours)
- Sequenced logically (prerequisite topics before advanced ones)
- Specific and actionable (concrete activities, not vague advice)
- Adaptive (prioritizing weak areas identified by mastery data)

Always return a valid JSON object matching this exact schema:
{
  "student_id": "<uuid>",
  "goal": "<string>",
  "total_weeks": <int>,
  "weeks": [
    {
      "week_number": <int>,
      "focus": "<string>",
      "days": [
        {
          "day": "<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>",
          "topics": ["<topic_id>"],
          "duration_minutes": <int>,
          "activities": ["<activity description>"]
        }
      ],
      "milestones": ["<milestone>"]
    }
  ],
  "raw_plan": "<brief narrative summary>"
}

Return ONLY the JSON, no markdown fences, no explanation."""


def build_user_prompt(
    student_name: str,
    goal: str,
    weeks: int,
    hours_per_week: float,
    mastery_summary: str,
    curriculum_context: str,
    target_topics: List[str] | None,
) -> str:
    target_str = (
        f"Focus specifically on these topics: {', '.join(target_topics)}"
        if target_topics
        else "Cover all relevant topics based on the student's gaps."
    )

    return f"""Create a {weeks}-week study plan for {student_name}.

GOAL: {goal}
AVAILABLE TIME: {hours_per_week} hours/week
{target_str}

STUDENT MASTERY DATA (topic_id → mastery 0–1):
{mastery_summary}

RELEVANT CURRICULUM CONTEXT:
{curriculum_context}

Generate a complete {weeks}-week plan. Prioritize topics with low mastery. 
Schedule easier/foundational topics early in the week, harder topics mid-week.
Keep each study session between 30–90 minutes.
Include varied activities: concept review, practice problems, flashcards, past papers."""
